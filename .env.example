# Trip App - Supabase Configuration
# SETUP STEPS:
# 1. Create a project at https://supabase.com
# 2. In SQL Editor, run the full script from supabase/schema.sql
# 3. Under Authentication -> Providers -> Email, turn OFF "Confirm email" so sign up works instantly
# 4. In Project Settings -> API, copy Project URL and anon public key below
# 5. Under Storage, verify the "trip-assets" bucket exists with public access
# 6. Paste your credentials below:
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
